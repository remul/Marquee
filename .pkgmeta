package-as: Marquee

ignore:
  - .gitignore
  - .pkgmeta
  - .github
  # Generates Data/TitleData.lua; not needed in game.
  - tools
  # Planning notes for development.
  - ROADMAP.md
  # Logo sources for GitHub and CurseForge; only Media/Icon.tga is used in game.
  - Media/Emblem.svg
  - Media/Emblem.png
  - Media/Logo.svg
  - Media/Logo.png

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
